# Server-side only. Never exposed to the browser.
OPENAI_API_KEY=
# Optional: model for every AI stage (needs structured outputs + image input). Use a dated
# snapshot so usage counts toward OpenAI's complimentary data-sharing tokens.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# Optional: a different model for script writing and rewrites only, e.g. gpt-5.4-2026-03-05.
# A full-size model draws from the smaller complimentary pool. Leave empty to use OPENAI_MODEL.
OPENAI_WRITER_MODEL=
# Optional: OpenAI-compatible base URL (proxy or gateway).
OPENAI_BASE_URL=
# Optional: set to "demo" to use the keyless demo writer (development and tests).
AI_PROVIDER=
# A production build uses OPENAI_API_KEY only with sign-in (Firebase below) and quotas
# (FIREBASE_SERVICE_ACCOUNT). "1" lifts that for a private preview; never on a public deployment.
AI_ALLOW_UNMETERED=

# Firebase web app config (public identifiers, not secrets). Print with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project teleprompt-pro-b210e
# Leave empty to run without sign-in (local-only workspace).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key registered with Firebase App Check. On localhost the app
# uses a debug token; set one here (and list it in the console) before turning on enforcement.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Optional: public origin for social-card links (e.g. https://cueframe.app). On Vercel the
# production domain is used automatically.
NEXT_PUBLIC_SITE_URL=
# Optional: set to "off" to skip sign-in even when Firebase is configured (e2e tests do this).
NEXT_PUBLIC_AUTH_MODE=
# Server-side only. Firebase service-account key (the JSON on one line). Required for AI in production:
# it turns on the daily AI allowances and rejects revoked sessions and disabled users.
# Never commit it; on Vercel store it as a sensitive environment variable.
FIREBASE_SERVICE_ACCOUNT=
# Server-side only. Comma-separated verified sign-in emails exempt from the daily AI allowances
# (their usage is still recorded). Takes effect only with FIREBASE_SERVICE_ACCOUNT (quotas on).
QUOTA_EXEMPT_EMAILS=
