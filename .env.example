# Server-side only. Never exposed to the browser.
OPENAI_API_KEY=
# Optional: model for slide analysis and script writing (needs structured outputs + image input).
OPENAI_MODEL=gpt-5.4-mini
# Optional: model that decides pauses, pointing, slow and bold in finished scripts (default gpt-5.4).
OPENAI_DELIVERY_MODEL=gpt-5.4
# Optional: OpenAI-compatible base URL (proxy or gateway).
OPENAI_BASE_URL=
# Optional: set to "demo" to use the keyless demo writer (development and tests).
AI_PROVIDER=
