    "@lexical/selection": "^0.49.0",
    "cross-env": "^10.1.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lexical": "^0.49.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "openai": "^7.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "22.19.19",
