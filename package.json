{
  "name": "cueframe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "cross-env AI_PROVIDER=demo next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore,storage --project demo-cueframe \"node --import tsx --test tests/rules/*.test.ts\"",
    "test:e2e": "playwright test",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "sample-deck": "node scripts/make-sample-deck.mjs",
    "preview": "next start"
  },
  "dependencies": {
    "@lexical/history": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "cross-env": "^10.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lexical": "^0.49.0",
    "lucide-react": "^1.28.0",
    "motion": "^13.4.3",
    "next": "16.2.6",
    "openai": "^7.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
