{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cueframe-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3400,
      "autoPort": true
    },
    {
      "name": "cueframe-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3500"
      ],
      "port": 3500
    },
    {
      "name": "cueframe-demo-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "WRANGLER_LOG_PATH=.wrangler/wrangler.log",
        "vinext",
        "dev",
        "--port",
        "3300"
      ],
      "port": 3300
    },
    {
      "name": "cueframe-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "vite",
        "preview",
        "--port",
        "3200",
        "--strictPort"
      ],
      "port": 3200
    }
  ]
}
