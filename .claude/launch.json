{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cueframe-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3400,
      "autoPort": true
    },
    {
      "name": "cueframe-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3500"
      ],
      "port": 3500
    },
    {
      "name": "cueframe-demo-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "next",
        "dev",
        "--port",
        "3300"
      ],
      "port": 3300
    },
    {
      "name": "cueframe-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "next",
        "start",
        "--port",
        "3200"
      ],
      "port": 3200
    },
    {
      "name": "cueframe-demo-noauth",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "AI_PROVIDER=demo",
        "NEXT_PUBLIC_AUTH_MODE=off",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3500"
      ],
      "port": 3500
    }
  ]
}
